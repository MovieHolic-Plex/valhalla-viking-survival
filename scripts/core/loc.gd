extends Node
## 로컬라이제이션. 오토로드 이름: Loc
## 번역을 코드에 내장해 임포트 파이프라인 없이도 한국어가 항상 동작한다.
## 기본 언어는 한국어이며, 일시정지 메뉴에서 영어로 전환할 수 있다.

func _ready() -> void:
	var ko := Translation.new()
	ko.locale = "ko"
	var en := Translation.new()
	en.locale = "en"
	for key in KO:
		ko.add_message(key, KO[key])
	for key in EN:
		en.add_message(key, EN[key])
	TranslationServer.add_translation(ko)
	TranslationServer.add_translation(en)
	TranslationServer.set_locale("ko")

