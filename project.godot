[internationalization]

locale/fallback="ko"
locale/test="ko"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemy"
3d_physics/layer_4="resource_node"
3d_physics/layer_5="building"
3d_physics/layer_6="item_drop"
3d_physics/layer_7="water"
3d_physics/layer_8="projectile"

[physics]

3d/default_gravity=22.0
common/physics_ticks_per_second=60

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="forward_plus"
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
environment/defaults/default_clear_color=Color(0.36, 0.45, 0.55, 1)
