; Engine configuration file.
; 발할라 (Valhalla) — 발헤임 스타일 바이킹 서바이벌
; Godot 4.4

config_version=5

[application]

config/name="발할라 — 바이킹 서바이벌"
config/name_localized={
"en": "Valhalla — Viking Survival",
"ko": "발할라 — 바이킹 서바이벌"
}
config/description="절차적으로 생성되는 북유럽 세계에서 채집하고, 짓고, 만들고, 신들에게 버림받은 보스를 사냥하는 서바이벌 게임."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://assets/icon.svg"
boot_splash/bg_color=Color(0.05, 0.06, 0.07, 1)
boot_splash/show_image=false

[autoload]

Const="*res://scripts/core/const.gd"
Loc="*res://scripts/core/loc.gd"
ItemDB="*res://scripts/core/item_db.gd"
RecipeDB="*res://scripts/core/recipe_db.gd"
MeshFactory="*res://scripts/gfx/mesh_factory.gd"
TexLib="*res://scripts/gfx/tex_lib.gd"
MatLib="*res://scripts/gfx/mat_lib.gd"
GameState="*res://scripts/core/game_state.gd"
SaveSystem="*res://scripts/core/save_system.gd"
Sfx="*res://scripts/core/sfx.gd"
Net="*res://scripts/core/net.gd"

[debug]

gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_signal=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/integer_division=0

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

